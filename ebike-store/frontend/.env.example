# Copy to ".env" if you want to change these. ONLY public values belong in this file (they are visible in the browser).
# Leave VITE_API_URL empty in development (Vite forwards /api to the backend automatically).
# In production, set it to your API address only if the API is on a different domain, e.g. https://api.yourshop.com
VITE_API_URL=
VITE_SITE_NAME=VoltRide
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
# Optional: full URL of a hero photo (for example uploaded to Cloudinary)
VITE_HERO_IMAGE_URL=
