# ===== E-Bike Store backend settings =====
# Copy this file to ".env" (in the backend folder) and replace the placeholders. NEVER commit ".env".

APP_ENV=development                 # use "production" on the live server
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/ebike_store
# Generate a long random value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# The public address of the website (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
# Production single-server mode: folder of the built website (the Docker image sets this for you)
FRONTEND_DIST=

# Cookies: must be true when the site is served over HTTPS (production)
COOKIE_SECURE=false

# Store rules. Money is in whole units of the currency (XAF has no decimals)
CURRENCY=XAF
TAX_RATE_PERCENT=0
SHIPPING_STANDARD_FEE=5000
SHIPPING_EXPRESS_FEE=15000
SHIPPING_COUNTRIES=US
UNPAID_ORDER_TTL_MINUTES=30

# Cloudinary (image uploads). Get these from your Cloudinary dashboard. Keep private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5

# Payments. "test" = built-in simulator (no real money). A real provider needs an adapter (see README > Payments).
PAYMENT_MODE=test
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=

# Email (optional). If SMTP_HOST is empty no emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=orders@your-domain.example
ADMIN_NOTIFICATION_EMAIL=

RATE_LIMIT_ENABLED=true
